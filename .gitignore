# Build output
/target/
**/*.rs.bk

# Local caches and client-derived output
/.cache/
/captures/
/.codebase-memory/
/tools/spec-extract/out/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# .NET build output (only under dotnet/: crates/*/src/bin/ holds the Rust binaries' sources)
/dotnet/**/bin/
/dotnet/**/obj/

# Editors / OS
.idea/
.vscode/
.DS_Store

# SDE archives and extracted builds are fetched on first start (eve-sde ensure), never committed
/sde/data/
