# Settings for tools/windows/start-server.ps1 and tools/server/start-server.sh.
# Copy this file to server.env (git-ignored) and change what you need. KEY=VALUE per line; '#' starts a comment.
# Precedence: the environment, then server.env, then the defaults the scripts set.
#
# PostgreSQL 18 (the database is created if missing). Put the password here, not in the scripts.
# EVE_PG_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/eve
#
# Where the processes listen. The host and the simulation talk over TCP here, not Unix sockets.
# EVE_HOST=tcp:127.0.0.1:26010
# EVE_SIM_LISTEN=127.0.0.1:26011
# EVE_SIM_SOCKET=tcp:127.0.0.1:26011
# EVE_NET_LISTEN=127.0.0.1:26000
#
# Accounts: create unknown user names on first login (1), and accept any password (0 = check it).
# EVE_DEV_AUTO_CREATE=1
# EVE_DEV_SKIP_PASSWORD=0
#
# NPC market seed on the first start: skip (default) or auto (fetches CCP's ESI; needs internet access).
# EVE_MARKET_SEED=skip
#
# Optional, development starts only (start-server-dev.bat): RPC diagnostics.
# EVE_MAX_EXPENSIVE_RPC_UNITS_PER_MINUTE=120
# EVE_TRACE_RPC=full
# EVE_STRICT_RPC=1
