<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Unicode normalization (character names) needs ICU; the repository default is invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Eve.Services.CharacterSelect/Eve.Services.CharacterSelect.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="../../../oracle/fixtures/scenarios/*.json" Link="fixtures/scenarios/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
