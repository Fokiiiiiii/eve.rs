<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Unicode normalization (character names) needs ICU; the repository default is invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Eve.Characters/Eve.Characters.csproj" />
    <ProjectReference Include="../../src/Eve.Inventory/Eve.Inventory.csproj" />
    <ProjectReference Include="../../src/Eve.Sde/Eve.Sde.csproj" />
    <ProjectReference Include="../../src/Eve.Events/Eve.Events.csproj" />
    <ProjectReference Include="../../src/Eve.Relations/Eve.Relations.csproj" />
    <ProjectReference Include="../../src/Eve.Scheduler/Eve.Scheduler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="../../../oracle/fixtures/scenarios/*.json" Link="fixtures/scenarios/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
